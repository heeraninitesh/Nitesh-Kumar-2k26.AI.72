# Question No 1
total = 0
marks_list = []

for i in range(1, 6):
    marks = float(input(f"Enter marks of subject {i}: "))
    marks_list.append(marks)
    total += marks

percentage = (total / 500) * 100

# Grade calculation
if percentage >= 80:
    grade = "A+"
elif percentage >= 70:
    grade = "A"
elif percentage >= 60:
    grade = "B"
elif percentage >= 50:
    grade = "C"
else:
    grade = "F"

# Pass/Fail - fail if any subject < 33
if all(m >= 33 for m in marks_list) and percentage >= 40:
    result = "Pass"
else:
    result = "Fail"

print(f"\nTotal Marks: {total}")
print(f"Percentage: {percentage:.2f}%")
print(f"Grade: {grade}")
print(f"Result: {result}")
